# Leave VITE_API_URL empty in development — vite.config.js proxies /api and
# /media to the backend, so the browser sees a same-origin request and CORS
# never comes into play.
VITE_API_URL=

# Backend origin the dev proxy forwards to.
VITE_API_TARGET=http://localhost:8000

# In production, if the frontend is served from a different origin than the
# API, set the API's public origin here and add it to CORS_ORIGINS in the
# backend .env:
# VITE_API_URL=https://api.yourblog.com
