# ============================================================================
# AutoBlog — copy to .env and fill in. Never commit the real .env.
# ============================================================================

# ---- app -------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
# openssl rand -hex 32
SECRET_KEY=change-me-to-a-64-char-hex-string-generated-with-openssl-rand
# openssl rand -hex 16   (sent as X-API-Key on admin/write endpoints)
ADMIN_API_KEY=change-me-32-hex-chars
# Vite dev server (5173) + preview (4173). Add your production frontend origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ---- datastores ------------------------------------------------------------
DATABASE_URL=postgresql://autoblog:autoblog@postgres:5432/autoblog
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

VECTOR_BACKEND=pgvector
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ---- AI models -------------------------------------------------------------
# Switch the whole writing pipeline with one variable: openai | claude
MODEL_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Two-tier model strategy: SMART writes, FAST classifies/ranks/does social.
ANTHROPIC_MODEL_SMART=claude-opus-4-8
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_EFFORT=high
OPENAI_MODEL_SMART=gpt-5.1
OPENAI_MODEL_FAST=gpt-5.1-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- images ----------------------------------------------------------------
IMAGE_PROVIDER=openai          # openai | flux | stability | none
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
# REPLICATE_API_TOKEN=r8_...   # for IMAGE_PROVIDER=flux
# STABILITY_API_KEY=sk-...     # for IMAGE_PROVIDER=stability
IMAGE_STORAGE=local
IMAGE_LOCAL_DIR=/data/images
# S3_BUCKET=my-blog-assets
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ---- publishing ------------------------------------------------------------
PUBLISH_TARGETS=markdown       # csv: wordpress,ghost,medium,custom,markdown
PUBLISH_STATUS=draft           # draft until you trust the output, then: publish

WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=admin
WORDPRESS_PASSWORD=xxxx xxxx xxxx xxxx   # WP Application Password

# GHOST_ADMIN_API_URL=https://yourblog.ghost.io
# GHOST_ADMIN_API_KEY=64charid:64charsecret
# MEDIUM_INTEGRATION_TOKEN=
# CUSTOM_CMS_URL=https://cms.example.com/api/posts
# CUSTOM_CMS_TOKEN=

SITE_BASE_URL=https://yourblog.com
SITE_NAME=Your Tech Blog
AUTHOR_NAME=Editorial Desk
MARKDOWN_OUTPUT_DIR=/data/posts

# ---- schedule --------------------------------------------------------------
TIMEZONE=Asia/Kolkata
SCHEDULE=0 9,18 * * *          # 9:00 AM and 6:00 PM local
RUN_ON_STARTUP=false

# ---- pipeline tuning -------------------------------------------------------
COLLECT_LOOKBACK_HOURS=24
MAX_ITEMS_PER_SOURCE=40
DEDUPE_SIMILARITY_THRESHOLD=0.86
RANK_TOP_N=10
ARTICLE_MIN_WORDS=1500
ARTICLE_MAX_WORDS=2500
POSTS_PER_RUN=1
HUMAN_REVIEW=false

SCRAPE_ENABLED=true
RESPECT_ROBOTS_TXT=true
HTTP_USER_AGENT=AutoBlogBot/1.0 (+https://yourblog.com/bot)

# ---- budget & alerting -----------------------------------------------------
DAILY_COST_LIMIT_USD=25
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# SENTRY_DSN=

# ---- optional source credentials ------------------------------------------
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# GITHUB_TOKEN=            # raises GitHub API limit 60/h -> 5000/h
# PRODUCTHUNT_TOKEN=
